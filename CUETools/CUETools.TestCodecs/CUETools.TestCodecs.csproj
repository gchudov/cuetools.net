<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>CUETools.TestCodecs</RootNamespace>
    <AssemblyName>CUETools.TestCodecs</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <OutputPath>$(CueToolsBinRoot)tests\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AccurateRipVerifyTest.cs" />
    <Compile Include="ALACWriterTest.cs" />
    <Compile Include="BitWriterTest.cs" />
    <Compile Include="CodecsTest.cs" />
    <Compile Include="Crc32Test.cs" />
    <Compile Include="FlacWriterTest.cs" />
    <Compile Include="FlakeWriterTest.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="SOXResamplerTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Freedb\Freedb.csproj" Condition="'$(EnableDormantFreedb)' == 'true'" />
    <ProjectReference Include="..\..\CUETools.AccurateRip\CUETools.AccurateRip.csproj" />
    <ProjectReference Include="..\..\CUETools.CDImage\CUETools.CDImage.csproj" />
    <ProjectReference Include="..\..\CUETools.Codecs.ALAC\CUETools.Codecs.ALAC.csproj" />
    <ProjectReference Include="..\..\CUETools.Codecs.Flake\CUETools.Codecs.Flake.csproj" />
    <ProjectReference Include="..\..\CUETools.Codecs.libFLAC\CUETools.Codecs.libFLAC.csproj" />
    <ProjectReference Include="..\..\CUETools.Codecs.LossyWAV\CUETools.Codecs.LossyWAV.csproj" />
    <ProjectReference Include="..\..\CUETools.Codecs\CUETools.Codecs.csproj" />
    <ProjectReference Include="..\..\CUETools.Compression\CUETools.Compression.csproj" />
    <ProjectReference Include="..\..\CUETools.DSP.Resampler\CUETools.DSP.Resampler.csproj" />
    <ProjectReference Include="..\..\CUETools.Ripper\CUETools.Ripper.csproj" />
    <ProjectReference Include="..\..\CUETools.TestHelpers\CUETools.TestHelpers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\alac.m4a" CopyToOutputDirectory="PreserveNewest" TargetPath="alac.m4a" />
    <None Update="Data\flacwriter1.flac" CopyToOutputDirectory="PreserveNewest" TargetPath="flacwriter1.flac" />
    <None Update="Data\flake.flac" CopyToOutputDirectory="PreserveNewest" TargetPath="flake.flac" />
    <None Update="Data\hires1.flac" CopyToOutputDirectory="PreserveNewest" TargetPath="hires1.flac" />
    <None Update="Data\hires1.wav" CopyToOutputDirectory="PreserveNewest" TargetPath="hires1.wav" />
    <None Update="Data\pipe.wav" CopyToOutputDirectory="PreserveNewest" TargetPath="pipe.wav" />
    <None Update="Data\test.flac" CopyToOutputDirectory="PreserveNewest" TargetPath="test.flac" />
    <None Update="Data\test.wav" CopyToOutputDirectory="PreserveNewest" TargetPath="test.wav" />
    <None Include="..\..\ThirdPartyDebug\x64\libFLAC_dynamic.dll" Condition="'$(Configuration)' == 'Debug'" CopyToOutputDirectory="PreserveNewest" TargetPath="libFLAC_dynamic.dll" />
    <None Include="..\..\ThirdParty\x64\libFLAC_dynamic.dll" Condition="'$(Configuration)' == 'Release'" CopyToOutputDirectory="PreserveNewest" TargetPath="libFLAC_dynamic.dll" />
  </ItemGroup>

</Project>
