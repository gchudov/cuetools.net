<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CUERipper</AssemblyName>
    <RootNamespace>CUETools</RootNamespace>
    <Version>2.1.8</Version>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
    <NoWarn>$(NoWarn);CS0618;SYSLIB0014;SYSLIB0021;SYSLIB0045;CS8981</NoWarn>
    <RipperSource>$(MSBuildThisFileDirectory)..</RipperSource>
  </PropertyGroup>
  <!-- The Linux helper is a separate GPL executable. Compile the original managed
       reader, encoder and verification sources without changing the Windows projects. -->
  <ItemGroup>
    <Compile Include="$(RipperSource)/Bwg.Logging/**/*.cs;$(RipperSource)/Bwg.Scsi/**/*.cs;$(RipperSource)/CUETools.Ripper/**/*.cs;$(RipperSource)/CUETools.Ripper.SCSI/**/*.cs;$(RipperSource)/CUETools.Codecs/**/*.cs;$(RipperSource)/CUETools.Codecs.Flake/**/*.cs;$(RipperSource)/CUETools.CDImage/**/*.cs;$(RipperSource)/CUETools.AccurateRip/**/*.cs;$(RipperSource)/CUETools.Parity/**/*.cs;$(RipperSource)/CUETools.CTDB/**/*.cs;$(RipperSource)/CUETools.CTDB.Types/**/*.cs;$(RipperSource)/CUETools.Ripper.Console/**/*.cs;$(RipperSource)/ThirdParty/taglib-sharp/src/**/*.cs"
             Exclude="$(RipperSource)/**/obj/**;$(RipperSource)/**/bin/**;$(RipperSource)/**/AssemblyInfo.cs;$(RipperSource)/Bwg.Scsi/WinDev.cs;$(RipperSource)/Bwg.Scsi/DeviceManager.cs;$(RipperSource)/Bwg.Scsi/DeviceInfo.cs" />
    <Compile Include="Scsi/*.cs;OpticalDrives.cs" />
    <EmbeddedResource Include="../Bwg.Scsi/Messages.resx" LogicalName="Bwg.Scsi.Messages.resources" />
    <EmbeddedResource Include="../CUETools.Ripper.SCSI/Resource1.resx" LogicalName="CUETools.Ripper.SCSI.Resource1.resources" />
    <EmbeddedResource Include="../CUETools.Codecs.Flake/Properties/Resources.resx" LogicalName="CUETools.Codecs.Flake.Properties.Resources.resources" />
    <PackageReference Include="DeviceId" Version="4.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
